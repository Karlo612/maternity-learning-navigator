# Copy this file to .env before running Docker Compose. These values are local-only.
COMPOSE_APP_KEY=base64:generate-with-php-artisan-key-generate
COMPOSE_DB_DATABASE=maternity_navigator
COMPOSE_DB_USERNAME=maternity_app
COMPOSE_DB_PASSWORD=replace-with-a-local-database-password
COMPOSE_DB_ROOT_PASSWORD=replace-with-a-different-local-root-password
COMPOSE_ML_TOKEN=replace-with-a-random-local-service-token
COMPOSE_QUESTION_HMAC_KEY=replace-with-a-random-local-hmac-key
